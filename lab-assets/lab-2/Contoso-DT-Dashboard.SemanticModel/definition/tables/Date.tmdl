table Date
	dataCategory: Time

	column DateKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DateKey

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column MonthNum
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MonthNum

	column MonthIndex
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: MonthIndex

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNum

	/// Month and year label, e.g. Dec 2025
	column MonthYear
		dataType: string
		summarizeBy: none
		sourceColumn: MonthYear
		sortByColumn: MonthIndex

	column IsCurrentMonth
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: IsCurrentMonth

	column Date
		dataType: dateTime
		isHidden
		summarizeBy: none
		sourceColumn: Date

	partition Date = m
		mode: import
		source = ```
			// Synthetic monthly calendar Dec 2024 - Dec 2025
			let Source = #table(
			type table [DateKey = Int64.Type, Year = Int64.Type, MonthNum = Int64.Type, MonthIndex = Int64.Type, MonthName = text, MonthYear = text, IsCurrentMonth = Int64.Type, Date = date],
			{
				{202412, 2024, 12, 0, "December", "Dec 2024", 0, #date(2024,12,1)},
				{202501, 2025, 1, 1, "January", "Jan 2025", 0, #date(2025,1,1)},
				{202502, 2025, 2, 2, "February", "Feb 2025", 0, #date(2025,2,1)},
				{202503, 2025, 3, 3, "March", "Mar 2025", 0, #date(2025,3,1)},
				{202504, 2025, 4, 4, "April", "Apr 2025", 0, #date(2025,4,1)},
				{202505, 2025, 5, 5, "May", "May 2025", 0, #date(2025,5,1)},
				{202506, 2025, 6, 6, "June", "Jun 2025", 0, #date(2025,6,1)},
				{202507, 2025, 7, 7, "July", "Jul 2025", 0, #date(2025,7,1)},
				{202508, 2025, 8, 8, "August", "Aug 2025", 0, #date(2025,8,1)},
				{202509, 2025, 9, 9, "September", "Sep 2025", 0, #date(2025,9,1)},
				{202510, 2025, 10, 10, "October", "Oct 2025", 0, #date(2025,10,1)},
				{202511, 2025, 11, 11, "November", "Nov 2025", 0, #date(2025,11,1)},
				{202512, 2025, 12, 12, "December", "Dec 2025", 1, #date(2025,12,1)}
			}
		)
			in Source
			```
