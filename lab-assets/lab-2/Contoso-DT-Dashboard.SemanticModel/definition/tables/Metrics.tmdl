			RETURN CALCULATE(AVERAGE(Metrics[FCR]), 'Date'[DateKey] = _m)
			```
		formatString: 0.0
	measure 'AISolutions (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[AISolutions]), 'Date'[DateKey] = _m)
			```
		formatString: #,##0
	measure 'MTTR_P1 (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[MTTR_P1]), 'Date'[DateKey] = _m)
			```
		formatString: 0.0
	measure 'MTTR_P2 (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[MTTR_P2]), 'Date'[DateKey] = _m)
			```
		formatString: 0.0
	/// Availability % for Critical systems (latest month) shown as percentage
	measure 'Availability Critical %' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[AvailabilityCritical]), 'Date'[DateKey] = _m) / 100
			```
		formatString: 0.000%

	/// Availability % for High systems (latest month) shown as percentage
	measure 'Availability High %' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[AvailabilityHigh]), 'Date'[DateKey] = _m) / 100
			```
		formatString: 0.0000%

	/// Average Handling Time (latest month) formatted as mm:ss
	measure 'Avg Handling Time' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			VAR _s = CALCULATE(AVERAGE(Metrics[AHTSeconds]), 'Date'[DateKey] = _m)
			RETURN FORMAT(INT(_s/60), "00") & ":" & FORMAT(MOD(_s,60), "00")
			```
		formatString: 0

	/// Total end-user technology incidents opened in the latest month
	measure 'End User Incidents (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(SUM(Metrics[EndUserIncidents]), 'Date'[DateKey] = _m)
			```
		formatString: #,##0

	/// Change volume (count of changes) in the latest month
	measure 'Change Volume (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(SUM(Metrics[ChangeVolume]), 'Date'[DateKey] = _m)
			```
		formatString: #,##0

	/// Incident frequency in the latest month
	measure 'Incident Frequency (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(SUM(Metrics[IncidentFrequency]), 'Date'[DateKey] = _m)
			```
		formatString: #,##0

	/// Trend measures for line charts (one row per month)
	measure 'Avg MTTR P1' = AVERAGE(Metrics[MTTR_P1])
		formatString: 0.0

	measure 'Avg MTTR P2' = AVERAGE(Metrics[MTTR_P2])
		formatString: 0.0

	measure 'Change Success Rate' = AVERAGE(Metrics[ChangeSuccessRate])
		formatString: 0.0

	measure 'Cyber Exposure Score' = AVERAGE(Metrics[CyberExposureScore])
		formatString: #,##0

	measure 'End User Incidents' = SUM(Metrics[EndUserIncidents])
		formatString: #,##0

	measure 'Service Disruptions' = SUM(Metrics[ServiceDisruptions])
		formatString: #,##0

	measure 'Disruption Hours' = SUM(Metrics[DisruptionHours])
		formatString: #,##0.0

	measure 'Incident Count' = SUM(Metrics[IncidentFrequency])
		formatString: #,##0

	/// Gauge bounds and target for BitSight security rating
	measure 'BitSight Min' = 250
		formatString: #,##0

	measure 'BitSight Max' = 900
		formatString: #,##0

	measure 'BitSight Target' = 700
		formatString: #,##0

	/// TSA reportable cybersecurity incidents (latest month)
	measure 'TSA Reportable Incidents' = 0
		formatString: #,##0

	/// Critical cybersecurity incidents (latest month)
	measure 'Critical Cyber Incidents' = 0
		formatString: #,##0


