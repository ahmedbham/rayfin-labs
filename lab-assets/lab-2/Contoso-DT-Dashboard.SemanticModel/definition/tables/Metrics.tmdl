table Metrics
	measure 'ChangeSuccessRate (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[ChangeSuccessRate]), 'Date'[DateKey] = _m)
			```
		formatString: 0.0
	measure 'BitSightScore (Latest)' = ```
			VAR _m = CALCULATE(MAX('Date'[DateKey]), ALL('Date'))
			RETURN CALCULATE(AVERAGE(Metrics[BitSightScore]), 'Date'[DateKey] = _m)
			```
		formatString: #,##0
