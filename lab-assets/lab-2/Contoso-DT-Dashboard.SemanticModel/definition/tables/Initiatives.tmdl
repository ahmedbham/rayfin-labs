table Initiatives

	/// Total number of D&T initiatives
	measure 'Total Initiatives' = COUNTROWS(Initiatives)
		formatString: #,##0

	/// Number of active initiatives
	measure 'Active Initiatives' = CALCULATE(COUNTROWS(Initiatives), Initiatives[Status] = "Active")
		formatString: #,##0

	/// Number of completed initiatives
	measure 'Completed Initiatives' = CALCULATE(COUNTROWS(Initiatives), Initiatives[Status] = "Completed")
		formatString: #,##0

	/// Number of off-track initiatives
	measure 'Off-Track Initiatives' = CALCULATE(COUNTROWS(Initiatives), Initiatives[OffTrack] = 1)
		formatString: #,##0

	column InitiativeId
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: InitiativeId

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	column BusinessUnit
		dataType: string
		summarizeBy: none
		sourceColumn: BusinessUnit

	column OffTrack
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: OffTrack

	partition Initiatives = m
		mode: import
		source = ```
			// Synthetic D&T initiative portfolio
			let Source = #table(
			type table [InitiativeId = Int64.Type, Status = text, BusinessUnit = text, OffTrack = Int64.Type],
			{
