table AIDetections

	/// Total anomalies/exceptions detected by AI
	measure 'Total Detections' = SUM(AIDetections[DetectionCount])
		formatString: #,##0

	/// Claims AI detections (year to date)
	measure 'Claims AI YTD' = CALCULATE(SUM(AIDetections[DetectionCount]), AIDetections[SystemName] = "Claims AI")
		formatString: #,##0

	/// Provider AI detections (year to date)
	measure 'Provider AI YTD' = CALCULATE(SUM(AIDetections[DetectionCount]), AIDetections[SystemName] = "Provider AI")
		formatString: #,##0

	measure 'Claims AI Critical' = CALCULATE(SUM(AIDetections[DetectionCount]), AIDetections[SystemName] = "Claims AI", AIDetections[Severity] = "Critical")
		formatString: #,##0

	measure 'Claims AI High' = CALCULATE(SUM(AIDetections[DetectionCount]), AIDetections[SystemName] = "Claims AI", AIDetections[Severity] = "High")
		formatString: #,##0

	measure 'Provider AI Critical' = CALCULATE(SUM(AIDetections[DetectionCount]), AIDetections[SystemName] = "Provider AI", AIDetections[Severity] = "Critical")
		formatString: #,##0

	measure 'Provider AI High' = CALCULATE(SUM(AIDetections[DetectionCount]), AIDetections[SystemName] = "Provider AI", AIDetections[Severity] = "High")
		formatString: #,##0

	column DateKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: DateKey

	column SystemName
		dataType: string
		summarizeBy: none
		sourceColumn: SystemName

	column Severity
		dataType: string
		summarizeBy: none
		sourceColumn: Severity

	column DetectionCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: DetectionCount

	partition AIDetections = m
		mode: import
		source = ```
			// Synthetic AI-detected anomalies by system and severity
			let Source = #table(
			type table [DateKey = Int64.Type, SystemName = text, Severity = text, DetectionCount = Int64.Type],
			{
				{202412, "Claims AI", "Critical", 74},
				{202412, "Claims AI", "High", 923},
				{202412, "Provider AI", "Critical", 11},
				{202412, "Provider AI", "High", 73},
				{202501, "Claims AI", "Critical", 68},
				{202501, "Claims AI", "High", 917},
				{202501, "Provider AI", "Critical", 10},
				{202501, "Provider AI", "High", 81},
				{202502, "Claims AI", "Critical", 77},
				{202502, "Claims AI", "High", 972},
				{202502, "Provider AI", "Critical", 12},
				{202502, "Provider AI", "High", 100},
				{202503, "Claims AI", "Critical", 89},
				{202503, "Claims AI", "High", 1040},
